{
  "manifest_version": 3,
  "name": "OpenOrbit Event Automator",
  "version": "1.3.0",
  "description": "Reliably fills and validates the OpenOrbit create-event form from reusable event templates.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://openorbit.app/*"],
  "action": {
    "default_title": "OpenOrbit Event Automator",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://openorbit.app/create-event*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
