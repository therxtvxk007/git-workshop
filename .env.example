# Copy to .env and fill in. .env is git-ignored; never commit credentials.

# --- Storage roots -------------------------------------------------------
PRAMAANX_DATA_ROOT=./data
PRAMAANX_RUN_ROOT=./runs

# --- Logging -------------------------------------------------------------
PRAMAANX_LOG_LEVEL=INFO
PRAMAANX_LOG_FORMAT=console   # console | json

# --- Tier 0 sources ------------------------------------------------------
# GDELT 2.0 needs no key; the base URL is overridable for mirrors/caches.
PRAMAANX_GDELT_BASE_URL=https://data.gdeltproject.org/gdeltv2

# ACLED requires a registered account. Access terms govern redistribution:
# store credentials here, never the resulting data in git.
PRAMAANX_ACLED_EMAIL=
PRAMAANX_ACLED_API_KEY=

# ReliefWeb asks callers to identify themselves via an appname parameter.
PRAMAANX_RELIEFWEB_APPNAME=pramaan-x-zero-base

# data.gov.in user-issued API key (never use or commit the portal sample key).
# Registration/key help: https://www.data.gov.in/help
PRAMAANX_DATA_GOV_IN_API_KEY=

# --- Tier 1 sources (Phase 9+) -------------------------------------------
PRAMAANX_FIRMS_MAP_KEY=
PRAMAANX_COPERNICUS_USER=
PRAMAANX_COPERNICUS_PASSWORD=
PRAMAANX_OPENSKY_CLIENT_ID=
PRAMAANX_OPENSKY_CLIENT_SECRET=
PRAMAANX_GFW_API_TOKEN=

# --- Model serving (Phase 5+) --------------------------------------------
PRAMAANX_LLM_BASE_URL=http://localhost:8000/v1
PRAMAANX_LLM_API_KEY=
PRAMAANX_LLM_MODEL=
