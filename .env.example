# Copy to .env and fill in. .env is git-ignored; never commit credentials.

# --- Storage roots -------------------------------------------------------
PRAMAANX_DATA_ROOT=./data
PRAMAANX_RUN_ROOT=./runs

# --- Logging -------------------------------------------------------------
PRAMAANX_LOG_LEVEL=INFO
PRAMAANX_LOG_FORMAT=console   # console | json

# --- Tier 0 sources ------------------------------------------------------
# GDELT 2.0 needs no key; the base URL is overridable for mirrors/caches.
PRAMAANX_GDELT_BASE_URL=https://data.gdeltproject.org/gdeltv2

# ACLED requires a registered account. Access terms govern redistribution:
# store credentials here, never the resulting data in git.
PRAMAANX_ACLED_EMAIL=
PRAMAANX_ACLED_API_KEY=

# ReliefWeb requires every caller to identify itself with an appname, sent in
# the request URL. No key and no account -- but since 2025-11-01 the appname
# must be PRE-APPROVED by ReliefWeb. It is not a name you can simply choose:
# request one through the process linked from
# https://apidoc.reliefweb.int/parameters, then put the approved name here.
# An unapproved or misspelled name is refused at the origin with HTTP 403.
# The connector refuses to call the API without this rather than defaulting to
# something anonymous. Never commit the value: .env is git-ignored, and a
# contract test fails if any tracked config sets sources.reliefweb.appname.
PRAMAANX_RELIEFWEB_APPNAME=

# ReliefWeb egress. Everything below is optional and overrides
# sources.reliefweb.* in configuration; the standard proxy environment
# (HTTPS_PROXY, ALL_PROXY, NO_PROXY, SSL_CERT_FILE) is honoured by default.
# Used by the opt-in live test in tests/network/test_reliefweb_live.py.
# PRAMAANX_LIVE_RELIEFWEB=1
# PRAMAANX_HTTP_PROXY=socks5://127.0.0.1:1080
# PRAMAANX_CA_BUNDLE=/etc/ssl/certs/corp-root.pem

# data.gov.in API key (https://data.gov.in/apis)
PRAMAANX_DATA_GOV_IN_API_KEY=

# --- Tier 1 sources (Phase 9+) -------------------------------------------
PRAMAANX_FIRMS_MAP_KEY=
PRAMAANX_COPERNICUS_USER=
PRAMAANX_COPERNICUS_PASSWORD=
PRAMAANX_OPENSKY_CLIENT_ID=
PRAMAANX_OPENSKY_CLIENT_SECRET=
PRAMAANX_GFW_API_TOKEN=

# --- Model serving (Phase 5+) --------------------------------------------
PRAMAANX_LLM_BASE_URL=http://localhost:8000/v1
PRAMAANX_LLM_API_KEY=
PRAMAANX_LLM_MODEL=
