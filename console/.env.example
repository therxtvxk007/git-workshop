# Copy to .env.local and fill in. .env* files are git-ignored; never commit
# credentials. Only variables prefixed VITE_ are exposed to the browser -- and
# everything exposed to the browser is public, so nothing secret belongs here.

# --- Engine API ----------------------------------------------------------
# mock | rest
#
#   mock  Deterministic demo dataset built into the bundle. Every record is
#         marked is_demo and the top bar shows a SYNTHETIC pill.
#   rest  Talks to a Pramaan-X serving API. Failures surface as errors; the
#         console NEVER falls back to demo data, because fixtures behind a
#         LIVE indicator are worse than no data at all.
VITE_PRAMAANX_API_MODE=mock

# Required when VITE_PRAMAANX_API_MODE=rest. The app refuses to start in REST
# mode without it rather than quietly serving mock data.
# VITE_PRAMAANX_API_BASE_URL=https://engine.example.internal

# --- Persistence (Postgres) ----------------------------------------------
# Both must be set to use the Postgres backend in supabase/migrations. With
# either missing, the console falls back to browser local storage, says so in
# the top bar, and enforces none of the database policies.
#
# The anon key is designed to be public: it identifies the project, and every
# table it can reach is gated by row level security. The service_role key is
# NOT public and must never appear in a VITE_ variable.
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=

# --- Map -----------------------------------------------------------------
# A MapLibre style URL. Left unset on purpose: the console ships with no
# default tile provider so it never makes an unannounced third-party request,
# and it degrades to the ranked table with an explicit "map unavailable" state.
# Setting this is also what causes MapLibre itself to be downloaded at all.
# VITE_MAP_STYLE_URL=https://tiles.example.internal/style.json

# --- End-to-end tests ----------------------------------------------------
# Point Playwright at an already-installed Chromium instead of downloading one.
# PLAYWRIGHT_CHROMIUM_PATH=/opt/pw-browsers/chromium

# --- What is deliberately absent -----------------------------------------
# There is no engine API key here. Authenticated REST calls carry the
# signed-in user's session token; any engine-side credential belongs in the
# server function that proxies those calls. A key shipped to the browser is a
# key published. See docs/API_INTEGRATION.md.
